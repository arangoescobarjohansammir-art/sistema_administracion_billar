{
  "name": "tejo-billar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build --outDir dist/client && npm run build:admin && tsc -p tsconfig.server.json",
    "build:admin": "vite build --config admin/vite.config.mjs",
    "start": "node scripts/start.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "pdfkit": "^0.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
